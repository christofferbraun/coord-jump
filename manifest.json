{
  "manifest_version": 3,
  "name": "Coord Jump",
  "version": "0.1.0",
  "description": "Highlight text containing latitude/longitude in any format and jump straight to it in Google Maps.",
  "homepage_url": "https://github.com/christofferbraun/coord-jump",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications",
    "storage"
  ],
  "background": {
    "scripts": [
      "src/parser.js",
      "src/settings.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "Coord Jump",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "commands": {
    "jump-to-selection": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open the selected coordinates in Google Maps"
    },
    "jump-from-home": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Open directions from home to the selected coordinates"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "coord-jump@christofferbraun.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
